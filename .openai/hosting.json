{
  "version": 1,
  "build": {
    "command": "npm run build",
    "outputDirectory": "dist/client"
  },
  "runtime": {
    "command": "node dist/server/index.js",
    "websocket": true
  },
  "env": {
    "PUBLIC_APP_NAME": "${PUBLIC_APP_NAME}",
    "STUN_URL": "${STUN_URL}",
    "TURN_URL": "${TURN_URL}",
    "TURN_USERNAME": "${TURN_USERNAME}",
    "TURN_CREDENTIAL": "${TURN_CREDENTIAL}",
    "SESSION_SECRET": "${SESSION_SECRET}"
  },
  "bindings": {
    "DB": {
      "type": "d1",
      "placeholder": true
    }
  }
}
