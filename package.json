{
  "name": "randomconnect",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx src/server/index.ts\" \"vite --config vite.config.ts\"",
    "server": "tsx src/server/index.ts",
    "client": "vite --config vite.config.ts",
    "build": "tsc && vite --config vite.config.ts build",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@hono/node-ws": "^1.1.3",
    "hono": "^4.7.2",
    "nanoid": "^5.1.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
